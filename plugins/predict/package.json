{
  "name": "@hwfee/dsh-predict",
  "version": "0.1.2",
  "description": "下一句：在回答后建议下一条输入，Tab 填入，不自动发送；支持选择预测模型。 / Next Prompt: next-message suggestions with Tab to fill, no auto-send, and a configurable model.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "HwFee <1744567281@qq.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prediction",
    "ghost-text",
    "autocomplete"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/client.js",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "build:check": "node tools/build-client.mjs --check",
    "test": "node tools/build-client.mjs --check && node test/manifest.test.mjs && node test/predict.test.mjs && node test/settings.test.mjs && node test/ghost.test.mjs && node test/host.test.mjs && node test/client.test.mjs && node test/picker.test.mjs && node test/request.test.mjs && node test/reasoning.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "esbuild": "0.25.10"
  }
}
