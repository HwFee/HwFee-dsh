+				// WHY: same rule as the host guard — old metadata has no start lines, new
+				// metadata does, and this rebuild must not be the third place that drops them.
+				// Absent stays absent (the card falls back to 1..n); present-but-invalid fails.
+				if (oldStart !== void 0 && !(Number.isInteger(oldStart) && oldStart >= 0)) return null;
+				if (newStart !== void 0 && !(Number.isInteger(newStart) && newStart >= 0)) return null;
 				out.push({
 					path,
 					oldText,
-					newText
+					newText,
+					...(oldStart !== void 0 ? { oldStart } : {}),
+					...(newStart !== void 0 ? { newStart } : {})
 				});
 			}
 			return out;
 		}
