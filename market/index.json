    {
      "name": "dsh-cds-theme",
      "title": {
        "en": "Claude Design System Theme",
        "zh": "Claude 设计系统主题"
      },
      "description": {
        "en": "Remaps the host's --dsw-* tokens onto CDS warm-grey surfaces and the clay accent, refines the composer, sidebar, message rows, code blocks and markdown body, and adds a serif hero greeting plus a click-ripple home backdrop.",
        "zh": "把宿主的 --dsw-* 令牌整体重映射到 CDS 暖灰表面与陶土强调色，细化输入框、侧栏、消息行、代码块与 Markdown 正文，并加入首页衬线问候语与点击波纹背景。"
      },
      "icon": "https://raw.githubusercontent.com/HwFee/HwFee-dsh/main/plugins/cds-theme/icon.svg",
      "author": "HwFee",
